{
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": true,
  "autoUpdatesChannel": "latest",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "RevenueCat@RevenueCat": false,
    "agy@antigravity-cc": false,
    "clangd-lsp@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "expo@expo-plugins": false,
    "feature-dev@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "posthog@claude-plugins-official": false,
    "revenuecat-play-billing@RevenueCat": false,
    "stripe@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "upgrading-expo@expo-plugins": false,
    "vercel@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "RevenueCat": {
      "source": {
        "repo": "RevenueCat/ai-toolkit",
        "source": "github"
      }
    },
    "antigravity-cc": {
      "source": {
        "repo": "simplybychris/antigravity-plugin-cc",
        "source": "github"
      }
    },
    "cloudflare": {
      "source": {
        "repo": "cloudflare/skills",
        "source": "github"
      }
    },
    "expo-plugins": {
      "source": {
        "repo": "expo/skills",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(curl:*)",
      "Bash(do echo -n \"  $f: \" ffmpeg -i \"$f\" -af ebur128 -f null -)",
      "Bash(do echo -n \"$f: \" ffmpeg -i \"$f\" -af ebur128 -f null -)",
      "Bash(ffmpeg:*)",
      "Bash(find:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(swift:*)",
      "Bash(swiftlint:*)",
      "Bash(wc:*)",
      "Bash(xcodebuild:*)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_search",
      "mcp__gemini__consult_gemini",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id"
    ],
    "defaultMode": "auto",
    "deny": []
  },
  "skillOverrides": {
    "accessorysetupkit": "off",
    "adattributionkit": "off",
    "agents-sdk": "off",
    "alarmkit": "off",
    "app-clips": "off",
    "apple-on-device-ai": "off",
    "appmigrationkit": "off",
    "audioaccessorykit": "off",
    "authentication": "off",
    "avkit": "off",
    "browserenginekit": "off",
    "callkit": "off",
    "carplay": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "contacts-framework": "off",
    "core-bluetooth": "off",
    "core-nfc": "off",
    "coreml": "off",
    "cryptotokenkit": "off",
    "dockkit": "off",
    "durable-objects": "off",
    "energykit": "off",
    "financekit": "off",
    "gamekit": "off",
    "homekit": "off",
    "mapkit": "off",
    "metrickit": "off",
    "musickit": "off",
    "natural-language": "off",
    "paperkit": "off",
    "passkit": "off",
    "pdfkit": "off",
    "pencilkit": "off",
    "permissionkit": "off",
    "sandbox-sdk": "off",
    "scenekit": "off",
    "sensorkit": "off",
    "shareplay-activities": "off",
    "speech-recognition": "off",
    "tabletopkit": "off",
    "tipkit": "off",
    "turnstile-spin": "off",
    "weatherkit": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}